# Copy to apps/web/.env.local to override. Defaults work with the local backend via the Vite proxy.
# VITE_COMPANY_ID=ironline
# VITE_AS_OF=2026-10-30          # "tonight" for the demo dataset; the check audits as of this date
# VITE_USE_MOCKS=1               # show the original mock data, no backend needed
# VITE_DATA_URL=/data            # proxied to http://127.0.0.1:4000
# VITE_INFERENCE_URL=/inference  # proxied to http://127.0.0.1:4100
